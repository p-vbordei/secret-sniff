{
  "name": "secret-sniff",
  "version": "0.1.0",
  "description": "Scan text for credentials and API keys (AWS, GitHub, Stripe, OpenAI, Anthropic, JWT, PEM, ...). Zero dependencies. Format-anchored — not entropy-guessing.",
  "keywords": ["secrets", "credentials", "api-key", "scanner", "security", "redact"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Vlad Bordei",
    "email": "bordeivlad@gmail.com",
    "url": "https://github.com/p-vbordei"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-vbordei/secret-sniff.git"
  },
  "bugs": {
    "url": "https://github.com/p-vbordei/secret-sniff/issues"
  },
  "homepage": "https://github.com/p-vbordei/secret-sniff#readme",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  }
}
